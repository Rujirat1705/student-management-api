        },
        {
          "name": "Submit / Update Grade",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grade\": \"A\",\n  \"status\": \"COMPLETED\"\n}"
            },
            "url": "{{baseUrl}}/api/enrollments/1/"
          }
        }
      ]
    }
  ]
}